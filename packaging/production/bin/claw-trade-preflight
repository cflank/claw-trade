#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

fail() {
  printf '[FAIL] %s\n' "$*" >&2
  exit 1
}

test -d "${ROOT_DIR}/app/python/claw_trade" || fail "missing app/python/claw_trade"
test -d "${ROOT_DIR}/runtime/python-site-packages" || fail "missing runtime/python-site-packages"
test -f "${ROOT_DIR}/web/dist/index.html" || fail "missing web/dist/index.html"
test -x "${ROOT_DIR}/runtime/openclaw/openclaw.mjs" || fail "missing runtime/openclaw/openclaw.mjs"
test -d "${ROOT_DIR}/runtime/openclaw/dist" || fail "missing runtime/openclaw/dist"
test -f "${ROOT_DIR}/runtime/assets/agents.tar" || fail "missing runtime/assets/agents.tar"
test -f "${ROOT_DIR}/runtime/assets/openclaw_plugins.tar" || fail "missing runtime/assets/openclaw_plugins.tar"
test -f "${ROOT_DIR}/virbox/virbox-status-sdk-linux-x86_64.tgz" || fail "missing virbox/virbox-status-sdk-linux-x86_64.tgz"
test -f "${ROOT_DIR}/scripts/openclaw-gateway-rpc-helper.mjs" || fail "missing scripts/openclaw-gateway-rpc-helper.mjs"
test -f "${ROOT_DIR}/scripts/crypto/download_binance_public_data.py" || fail "missing scripts/crypto/download_binance_public_data.py"
test -f "${ROOT_DIR}/scripts/crypto/import_crypto_prepackaged_to_mongo.py" || fail "missing scripts/crypto/import_crypto_prepackaged_to_mongo.py"
test -d "${ROOT_DIR}/data/crypto-history-full/normalized-columnar-usdt-only" || fail "missing data/crypto-history-full/normalized-columnar-usdt-only"
find "${ROOT_DIR}/data/crypto-history-full/normalized-columnar-usdt-only/market=CRYPTO/dataset=daily_bar/granularity=daily" -name '*.parquet' -print -quit | grep -q . || fail "missing CRYPTO daily_bar parquet seed"
test -x /usr/bin/openssl || fail "missing /usr/bin/openssl"
test -f "${ROOT_DIR}/systemd/claw-trade-control.service" || fail "missing systemd/claw-trade-control.service"
test -f "${ROOT_DIR}/systemd/claw-trade-ui.service" || fail "missing systemd/claw-trade-ui.service"
test -f "${ROOT_DIR}/systemd/claw-trade-kiosk.service" || fail "missing systemd/claw-trade-kiosk.service"
test -x "${ROOT_DIR}/bin/claw-trade-kiosk" || fail "missing bin/claw-trade-kiosk"
test -x "${ROOT_DIR}/bin/claw-trade-rescue" || fail "missing bin/claw-trade-rescue"
test -x "${ROOT_DIR}/bin/claw-trade-auto-update" || fail "missing bin/claw-trade-auto-update"
test -x "${ROOT_DIR}/root-helper/claw-trade-apply-update" || fail "missing root-helper/claw-trade-apply-update"
test -x "${ROOT_DIR}/root-helper/claw-trade-watchdog" || fail "missing root-helper/claw-trade-watchdog"
test -f "${ROOT_DIR}/sudoers/claw-trade-update" || fail "missing sudoers/claw-trade-update"
test -f "${ROOT_DIR}/systemd/claw-trade-rescue.service" || fail "missing systemd/claw-trade-rescue.service"
test -f "${ROOT_DIR}/systemd/claw-trade-rescue-trigger.service" || fail "missing systemd/claw-trade-rescue-trigger.service"
test -f "${ROOT_DIR}/systemd/claw-trade-apply-update.service" || fail "missing systemd/claw-trade-apply-update.service"
test -f "${ROOT_DIR}/systemd/claw-trade-auto-update.service" || fail "missing systemd/claw-trade-auto-update.service"
test -f "${ROOT_DIR}/systemd/claw-trade-auto-update.timer" || fail "missing systemd/claw-trade-auto-update.timer"
test -f "${ROOT_DIR}/systemd/claw-trade-watchdog.service" || fail "missing systemd/claw-trade-watchdog.service"
test -f "${ROOT_DIR}/systemd/claw-trade-watchdog.timer" || fail "missing systemd/claw-trade-watchdog.timer"
grep -q '/opt/claw-trade/host-operations.lock' "${ROOT_DIR}/root-helper/claw-trade-apply-update" || fail "apply helper missing host lock contract"
grep -q '/opt/claw-trade/report-active.lock' "${ROOT_DIR}/root-helper/claw-trade-apply-update" || fail "apply helper missing report lock contract"
grep -q '/opt/claw-trade/data-work-active.lock' "${ROOT_DIR}/root-helper/claw-trade-apply-update" || fail "apply helper missing data work lock contract"
grep -q '/opt/claw-trade/host-operations.lock' "${ROOT_DIR}/root-helper/claw-trade-watchdog" || fail "watchdog helper missing host lock contract"
grep -q '/opt/claw-trade/report-active.lock' "${ROOT_DIR}/root-helper/claw-trade-watchdog" || fail "watchdog helper missing report lock contract"
grep -q '^RuntimeDirectory=claw-trade-watchdog$' "${ROOT_DIR}/systemd/claw-trade-watchdog.service" || fail "watchdog unit missing runtime directory contract"
grep -q '^RuntimeDirectoryMode=0700$' "${ROOT_DIR}/systemd/claw-trade-watchdog.service" || fail "watchdog unit missing runtime directory mode"
grep -q '^RuntimeDirectoryPreserve=yes$' "${ROOT_DIR}/systemd/claw-trade-watchdog.service" || fail "watchdog unit missing runtime directory preservation"
grep -q '^TimeoutStartSec=10min$' "${ROOT_DIR}/systemd/claw-trade-watchdog.service" || fail "watchdog unit timeout contract mismatch"
grep -q '^TimeoutStartSec=70min$' "${ROOT_DIR}/systemd/claw-trade-apply-update.service" || fail "apply unit timeout contract mismatch"

if find "${ROOT_DIR}" \( \
  -path "${ROOT_DIR}/.git" -o -path "${ROOT_DIR}/.git/*" -o \
  -path "${ROOT_DIR}/tests" -o -path "${ROOT_DIR}/tests/*" -o \
  -path "${ROOT_DIR}/docs" -o -path "${ROOT_DIR}/docs/*" -o \
  -path "${ROOT_DIR}/memory" -o -path "${ROOT_DIR}/memory/*" -o \
  -path "${ROOT_DIR}/web/research-ui/src" -o -path "${ROOT_DIR}/web/research-ui/src/*" -o \
  -name '.env.local' \
\) -print -quit | grep -q .; then
  fail "package contains forbidden development paths"
fi

if find "${ROOT_DIR}/app/python/claw_trade" -name '*.py' -print -quit | grep -q .; then
  fail "package contains claw_trade .py source"
fi

printf '[OK] production package preflight passed: %s\n' "${ROOT_DIR}"
