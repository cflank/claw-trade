#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

fail() {
  printf '[FAIL] %s\n' "$*" >&2
  exit 1
}

test -d "${ROOT_DIR}/app/python/claw_trade" || fail "missing app/python/claw_trade"
test -d "${ROOT_DIR}/runtime/python-site-packages" || fail "missing runtime/python-site-packages"
test -f "${ROOT_DIR}/web/dist/index.html" || fail "missing web/dist/index.html"
test -x "${ROOT_DIR}/runtime/openclaw/openclaw.mjs" || fail "missing runtime/openclaw/openclaw.mjs"
test -d "${ROOT_DIR}/runtime/openclaw/dist" || fail "missing runtime/openclaw/dist"
test -f "${ROOT_DIR}/runtime/assets/agents.tar" || fail "missing runtime/assets/agents.tar"
test -f "${ROOT_DIR}/runtime/assets/openclaw_plugins.tar" || fail "missing runtime/assets/openclaw_plugins.tar"
test -x /usr/bin/openssl || fail "missing /usr/bin/openssl"
test -f "${ROOT_DIR}/systemd/claw-trade-control.service" || fail "missing systemd/claw-trade-control.service"
test -f "${ROOT_DIR}/systemd/claw-trade-ui.service" || fail "missing systemd/claw-trade-ui.service"
test -f "${ROOT_DIR}/systemd/claw-trade-kiosk.service" || fail "missing systemd/claw-trade-kiosk.service"
test -x "${ROOT_DIR}/bin/claw-trade-kiosk" || fail "missing bin/claw-trade-kiosk"
test -x "${ROOT_DIR}/bin/claw-trade-rescue" || fail "missing bin/claw-trade-rescue"
test -x "${ROOT_DIR}/bin/claw-trade-auto-update" || fail "missing bin/claw-trade-auto-update"
test -x "${ROOT_DIR}/root-helper/claw-trade-apply-update" || fail "missing root-helper/claw-trade-apply-update"
test -f "${ROOT_DIR}/sudoers/claw-trade-update" || fail "missing sudoers/claw-trade-update"
test -f "${ROOT_DIR}/systemd/claw-trade-rescue.service" || fail "missing systemd/claw-trade-rescue.service"
test -f "${ROOT_DIR}/systemd/claw-trade-rescue-trigger.service" || fail "missing systemd/claw-trade-rescue-trigger.service"
test -f "${ROOT_DIR}/systemd/claw-trade-apply-update.service" || fail "missing systemd/claw-trade-apply-update.service"
test -f "${ROOT_DIR}/systemd/claw-trade-auto-update.service" || fail "missing systemd/claw-trade-auto-update.service"
test -f "${ROOT_DIR}/systemd/claw-trade-auto-update.timer" || fail "missing systemd/claw-trade-auto-update.timer"

if find "${ROOT_DIR}" \( \
  -path "${ROOT_DIR}/.git" -o -path "${ROOT_DIR}/.git/*" -o \
  -path "${ROOT_DIR}/tests" -o -path "${ROOT_DIR}/tests/*" -o \
  -path "${ROOT_DIR}/docs" -o -path "${ROOT_DIR}/docs/*" -o \
  -path "${ROOT_DIR}/memory" -o -path "${ROOT_DIR}/memory/*" -o \
  -path "${ROOT_DIR}/web/research-ui/src" -o -path "${ROOT_DIR}/web/research-ui/src/*" -o \
  -name '.env.local' \
\) -print -quit | grep -q .; then
  fail "package contains forbidden development paths"
fi

if find "${ROOT_DIR}/app/python/claw_trade" -name '*.py' -print -quit | grep -q .; then
  fail "package contains claw_trade .py source"
fi

printf '[OK] production package preflight passed: %s\n' "${ROOT_DIR}"
