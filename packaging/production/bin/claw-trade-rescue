#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON_BIN:-${ROOT_DIR}/runtime/python/bin/python}"

export PYTHONPATH="${ROOT_DIR}/app/python:${ROOT_DIR}/runtime/python-site-packages${PYTHONPATH:+:${PYTHONPATH}}"

exec "${PYTHON_BIN}" -m claw_trade.production.rescue_app \
  --host "${CLAW_TRADE_RESCUE_HOST:-127.0.0.1}" \
  --port "${CLAW_TRADE_RESCUE_PORT:-5175}" \
  --install-root "/opt/claw-trade"
