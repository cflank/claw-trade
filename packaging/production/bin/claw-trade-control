#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SHARED_ROOT="${CLAW_TRADE_SHARED_ROOT:-/opt/claw-trade/shared}"
RELEASE_NAME="$(basename "${ROOT_DIR}")"

for env_file in "${SHARED_ROOT}/config/claw-trade.env" "${SHARED_ROOT}/config/runtime.env"; do
  if [[ -f "${env_file}" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "${env_file}"
    set +a
  fi
done
SHARED_ROOT="${CLAW_TRADE_SHARED_ROOT:-${SHARED_ROOT}}"

export PYTHONPATH="${ROOT_DIR}/app/python:${ROOT_DIR}/runtime/python-site-packages${PYTHONPATH:+:${PYTHONPATH}}"
if [[ "${RELEASE_NAME}" =~ ^claw-trade-production-([0-9]+\.[0-9]+\.[0-9]+)- ]]; then
  export CLAW_TRADE_VERSION="${BASH_REMATCH[1]}"
fi
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${SHARED_ROOT}/cache/xdg}"
export NUMBA_CACHE_DIR="${NUMBA_CACHE_DIR:-${SHARED_ROOT}/cache/numba}"
export MPLCONFIGDIR="${MPLCONFIGDIR:-${SHARED_ROOT}/cache/matplotlib}"
export OPENCLAW_GATEWAY_CALL_BIN="${OPENCLAW_GATEWAY_CALL_BIN:-${ROOT_DIR}/runtime/openclaw/openclaw.mjs}"
export OPENCLAW_PACKAGE_DIR="${OPENCLAW_PACKAGE_DIR:-${ROOT_DIR}/runtime/openclaw}"
if [[ -z "${CLAW_TRADE_REPORT_RUN_DIR:-}" || "${CLAW_TRADE_REPORT_RUN_DIR}" != /* ]]; then
  export CLAW_TRADE_REPORT_RUN_DIR="${SHARED_ROOT}/runs"
else
  export CLAW_TRADE_REPORT_RUN_DIR
fi
export CLAW_TRADE_LOCAL_MONGODB_RUNTIME_DIR="${CLAW_TRADE_LOCAL_MONGODB_RUNTIME_DIR:-/opt/claw-trade/shared/tmp/mongodb}"
if [[ -x "${ROOT_DIR}/.runtime/mongodb/current/bin/mongod" && -z "${CLAW_TRADE_LOCAL_MONGODB_CURRENT_DIR:-}" ]]; then
  export CLAW_TRADE_LOCAL_MONGODB_CURRENT_DIR="${ROOT_DIR}/.runtime/mongodb/current"
fi
if [[ -z "${A_SHARE_FACTORY_SEED_PACKAGE:-}" ]]; then
  current_seeds=("${ROOT_DIR}"/data/current-seed-*.tar)
  if [[ -e "${current_seeds[0]}" ]]; then
    A_SHARE_FACTORY_SEED_PACKAGE="${current_seeds[$((${#current_seeds[@]} - 1))]}"
  else
    printf '[ERROR] missing data/current-seed-*.tar in production release\n' >&2
    exit 1
  fi
fi
export A_SHARE_FACTORY_SEED_PACKAGE
export A_SHARE_FACTORY_SEED_CHECKSUM="${A_SHARE_FACTORY_SEED_CHECKSUM:-${A_SHARE_FACTORY_SEED_PACKAGE}.sha256}"
export A_SHARE_FACTORY_SEED_COLUMNAR_ROOT="${A_SHARE_FACTORY_SEED_COLUMNAR_ROOT:-/opt/claw-trade/shared/cache/factory-seeds/current-seed/normalized}"
export CLAW_TRADE_CRYPTO_HISTORY_COLUMNAR_ROOT="${CLAW_TRADE_CRYPTO_HISTORY_COLUMNAR_ROOT:-${SHARED_ROOT}/data-gateway/crypto-history-full/normalized-columnar-usdt-only}"
export CLAW_TRADE_SKIP_OPENCLAW_WEIXIN_PLUGIN_INSTALL="${CLAW_TRADE_SKIP_OPENCLAW_WEIXIN_PLUGIN_INSTALL:-1}"

exec "${ROOT_DIR}/runtime/claw-trade-control-runtime" "$@"
