#!/usr/bin/env bash
set -euo pipefail
ROOT="${CLAW_TRADE_HOME:-/opt/claw-trade}"
CURRENT="${ROOT}/current"
SHARED="${ROOT}/shared"
if [[ -f "${SHARED}/config/runtime.env" ]]; then
  set -a
  # shellcheck disable=SC1090
  . "${SHARED}/config/runtime.env"
  set +a
fi
mkdir -p "${SHARED}/logs" "${SHARED}/data/openviking" "${SHARED}/data/openclaw-state"
exec "${CURRENT}/runtime/bin/claw-trade-control-runtime" "$@"
