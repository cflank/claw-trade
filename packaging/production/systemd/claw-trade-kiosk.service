[Unit]
Description=claw-trade kiosk browser
After=graphical.target claw-trade-ui.service
Requires=claw-trade-ui.service

[Service]
Type=simple
User=clawkiosk
Group=clawkiosk
Environment=DISPLAY=:0
ExecStart=/usr/bin/chromium --kiosk --no-first-run --disable-extensions --disable-dev-tools --disable-file-system --user-data-dir=/home/clawkiosk/.config/claw-trade-browser http://127.0.0.1:5175/
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=graphical.target
