[Unit]
Description=claw-trade kiosk browser
After=graphical.target claw-trade-ui.service
Wants=graphical.target
Requires=claw-trade-ui.service

[Service]
Type=simple
User=clawkiosk
Group=clawkiosk
Environment=DISPLAY=:0
Environment=CLAW_TRADE_KIOSK_BROWSER_BIN=/usr/bin/chromium-browser
EnvironmentFile=-/opt/claw-trade/shared/config/claw-trade.env
ExecStart=/opt/claw-trade/current/bin/claw-trade-kiosk
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=graphical.target
