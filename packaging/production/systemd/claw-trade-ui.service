[Unit]
Description=claw-trade UI backend
After=claw-trade-control.service
Requires=claw-trade-control.service

[Service]
Type=simple
User=clawtrade
Group=clawtrade
WorkingDirectory=/opt/claw-trade/current
EnvironmentFile=-/opt/claw-trade/shared/config/runtime.env
ExecStart=/opt/claw-trade/current/bin/claw-trade-ui
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/opt/claw-trade/shared

[Install]
WantedBy=multi-user.target
