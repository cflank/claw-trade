# claw-trade local development environment template.
# Copy this file to .env.local and fill real secrets there.
# .env.local is ignored by git.

TUSHARE_TOKEN=
# Optional: only set this when you need a temporary private Tushare proxy endpoint.
# TUSHARE_HTTP_URL=https://your-private-tushare-proxy.example
# CN_A_TUSHARE_HTTP_URL=https://your-private-tushare-proxy.example
TUSHARE_RATE_LIMIT_MAX_CALLS=
TUSHARE_RATE_LIMIT_WINDOW_SECONDS=
TUSHARE_RATE_LIMIT_SAFETY_MARGIN=
TUSHARE_RATE_LIMIT_OVERFLOW=
TUSHARE_RATE_LIMIT_WAIT_TIMEOUT_SECONDS=

# US / HK / global API provider credentials shown in UI Data Source Settings.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co
ALPHA_VANTAGE_RATE_LIMIT_MAX_CALLS=
ALPHA_VANTAGE_RATE_LIMIT_WINDOW_SECONDS=
ALPHA_VANTAGE_RATE_LIMIT_SAFETY_MARGIN=
ALPHA_VANTAGE_RATE_LIMIT_OVERFLOW=
ALPHA_VANTAGE_RATE_LIMIT_WAIT_TIMEOUT_SECONDS=
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_RATE_LIMIT_MAX_CALLS=
FINNHUB_RATE_LIMIT_WINDOW_SECONDS=
FINNHUB_RATE_LIMIT_SAFETY_MARGIN=
FINNHUB_RATE_LIMIT_OVERFLOW=
FINNHUB_RATE_LIMIT_WAIT_TIMEOUT_SECONDS=

CN_A_MONGODB_URI=mongodb://127.0.0.1:27017
CN_A_MONGODB_DATABASE=claw_trade
CN_A_MONGODB_CACHE_COLLECTION=cn_a_fundamental_cache

# CRYPTO provider cache/rate-limit settings.
# Cache hits are audit-visible material reuse, not fresh provider success.
CRYPTO_PROVIDER_CACHE_ENABLED=true
CRYPTO_PROVIDER_CACHE_REQUIRED=false
CRYPTO_PROVIDER_CACHE_STALE_POLICY=report_gap
# Optional. If empty, runtime may reuse CN_A_MONGODB_URI while writing only crypto_* collections.
CRYPTO_PROVIDER_CACHE_URI=
CRYPTO_CACHE_TTL_BINANCE_SPOT_OHLCV_SECONDS=900
CRYPTO_CACHE_TTL_BINANCE_HISTORY_SECONDS=21600
CRYPTO_CACHE_TTL_COINGECKO_SECONDS=900
CRYPTO_CACHE_TTL_DEFILLAMA_SECONDS=21600
CRYPTO_CACHE_TTL_NEWS_SECONDS=1800
CRYPTO_CACHE_TTL_ALTERNATIVE_ME_SECONDS=43200
CRYPTO_CACHE_TTL_POLYMARKET_SECONDS=300
CRYPTO_CACHE_TTL_LUNARCRUSH_SECONDS=900
CRYPTO_CACHE_TTL_SOCIAL_SECONDS=300
CRYPTO_RATE_LIMIT_BINANCE_PER_MINUTE=60
CRYPTO_RATE_LIMIT_COINGECKO_PER_MINUTE=20
CRYPTO_RATE_LIMIT_DEFILLAMA_PER_MINUTE=60
CRYPTO_RATE_LIMIT_SEARCH_PER_MINUTE=10

# CN_A news/search provider credentials.
# Leave blank locally if you do not have the key yet; the provider attempt should report AUTH_MISSING instead of faking data.
CN_A_NEWS_ENABLE_BOCHA=true
CN_A_NEWS_BOCHA_API_KEY=
CN_A_NEWS_ENABLE_TAVILY=true
CN_A_NEWS_TAVILY_API_KEY=
CN_A_NEWS_ENABLE_JINA=true
JINA_API_KEY=
CN_A_NEWS_ENABLE_NEWSNOW=true
CN_A_NEWS_NEWSNOW_API_KEY=
CN_A_NEWS_ENABLE_MINIMAX=true
CN_A_NEWS_MINIMAX_API_KEY=
CN_A_NEWS_MINIMAX_BASE_URL=https://api.minimaxi.com/v1
CN_A_NEWS_MINIMAX_MODEL=MiniMax-M2.7

# CRYPTO / BB data provider credentials.
# These names match D:\src\BB and are intended to become UI Settings fields later.
# Leave blank locally if you do not have the key yet; crypto provider attempts must report missing credentials instead of faking data.
COINGECKO_PRO_API_KEY=
COINGECKO_PRO_BASE_URL=https://pro-api.coingecko.com/api/v3
COINGECKO_PRO_RATE_LIMIT_MAX_CALLS=
COINGECKO_PRO_RATE_LIMIT_WINDOW_SECONDS=
COINGECKO_PRO_RATE_LIMIT_SAFETY_MARGIN=
COINGECKO_PRO_RATE_LIMIT_OVERFLOW=
COINGECKO_PRO_RATE_LIMIT_WAIT_TIMEOUT_SECONDS=
COINGECKO_DEMO_API_KEY=
COINGLASS_API_KEY=
COINGLASS_API_BASE=https://proxy.keystore.com.cn/api/v1/proxy/coinglass
COINGLASS_API_HEADER_NAME=X-Api-Key
COINGLASS_RATE_LIMIT_MAX_CALLS=10
COINGLASS_RATE_LIMIT_WINDOW_SECONDS=60
COINGLASS_RATE_LIMIT_SAFETY_MARGIN=1
COINGLASS_RATE_LIMIT_OVERFLOW=wait
COINGLASS_RATE_LIMIT_WAIT_TIMEOUT_SECONDS=75
GLASSNODE_API_KEY=
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org
FRED_RATE_LIMIT_MAX_CALLS=
FRED_RATE_LIMIT_WINDOW_SECONDS=
FRED_RATE_LIMIT_SAFETY_MARGIN=
FRED_RATE_LIMIT_OVERFLOW=
FRED_RATE_LIMIT_WAIT_TIMEOUT_SECONDS=
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
BOCHA_API_KEY=
NEWSAPI_API_KEY=
SERPAPI_API_KEY=
DEFILLAMA_API_KEY=
GITHUB_TOKEN=
CRYPTO_NEWS_OFFICIAL_SOURCES_JSON=
CRYPTO_NEWS_GITHUB_REPOS_JSON=
CRYPTO_NEWS_EXCHANGE_SOURCES_JSON=
CRYPTO_NEWS_REGULATORY_SOURCES_JSON=
CRYPTO_NEWS_ENABLE_DEFAULT_REGULATORY_SOURCES=false
CRYPTO_NEWS_USER_AGENT=claw-trade/crypto-news-data-pack
LUNARCRUSH_API_KEY=
LUNARCRUSH_COIN_ENDPOINT_TEMPLATE=https://lunarcrush.com/api4/public/coins/list/v2
X_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=
REDDIT_BEARER_TOKEN=
REDDIT_USER_AGENT=claw-trade/crypto-social-pack
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
CRYPTO_SOCIAL_DISCORD_CHANNEL_IDS_JSON=
CMC_API_KEY=
CRYPTOQUANT_API_KEY=
ETHERSCAN_API_KEY=
THEGRAPH_ACCESS_TOKEN=

# Local CRYPTO market pack. It internally compacts BB/CoinGlass and adds chart/OHLCV evidence.
CRYPTO_MARKET_BINANCE_BASE_URL=https://api.binance.com
CRYPTO_MARKET_BINANCE_SYMBOL_OVERRIDES_JSON=
CRYPTO_MARKET_QUOTE_ASSET=USDT
CRYPTO_MARKET_INTERVAL=1d
CRYPTO_MARKET_PACK_TIMEOUT_SECONDS=120
CRYPTO_MARKET_BB_TIMEOUT_SECONDS=60

# CRYPTO / BB runtime tuning. BB_PROVIDER_TIMEOUT_MS is BB's internal provider timeout;
# crypto_market_data_pack uses CRYPTO_MARKET_BB_TIMEOUT_SECONDS for the aggregate context call.
BB_PROVIDER_TIMEOUT_MS=10000
BB_PROVIDER_RETRY_ATTEMPTS=3
BB_PROVIDER_RETRY_DELAY_MS=250
BB_COINGLASS_CONTEXT_BUDGET=10
BB_COINGLASS_RATE_LIMIT_PER_MINUTE=10
BB_COINGLASS_RATE_LIMIT_WINDOW_MS=60000
BB_MCP_HTTP_HOST=127.0.0.1
BB_MCP_HTTP_PORT=8765
BB_MCP_HTTP_PATH=/mcp
BB_MCP_SERVER_PATH=/mnt/d/src/BB/mcp/crypto-data-mcp/dist/server.js
BB_MCP_CWD=/mnt/d/src/BB/mcp/crypto-data-mcp
