@@ -0,0 +1,579 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const qr = vi.hoisted(() => ({
+  cancel: vi.fn(),
+  list: vi.fn((): string[] => []),
+  start: vi.fn(),
+  wait: vi.fn(),
+}));
+
+vi.mock("./auth/login-qr.js", () => ({
+  cancelWeixinLogin: qr.cancel,
+  listActiveWeixinLoginSessionKeys: qr.list,
+  startWeixinLoginWithQr: qr.start,
+  waitForWeixinLogin: qr.wait,
+}));
+
+vi.mock("./util/logger.js", () => ({
+  logger: { info: vi.fn(), debug: vi.fn(), warn: vi.fn(), error: vi.fn() },
+}));
+
+type Handler = (options: Record<string, unknown>) => Promise<void> | void;
+
+let stateDir: string;
+let handlers: Map<string, Handler>;
+let running: Record<string, boolean>;
+let failStart: boolean;
+
+beforeEach(async () => {
+  vi.resetModules();
+  qr.cancel.mockReset().mockReturnValue({ cancelled: true, state: "cancelled" });
+  qr.list.mockReset().mockReturnValue([]);
+  qr.start.mockReset().mockImplementation(async (options: { sessionKey: string }) => ({
+    qrcodeUrl: "https://example.test/qr",
+    message: "scan",
+    sessionKey: options.sessionKey,
+  }));
+  qr.wait.mockReset();
+  stateDir = fs.mkdtempSync(path.join(os.tmpdir(), "weixin-replacement-"));
+  process.env.OPENCLAW_STATE_DIR = stateDir;
+  running = {};
+  failStart = false;
+  handlers = new Map();
+  const { registerWeixinReplacementGatewayMethods } = await import("./replacement.js");
+  registerWeixinReplacementGatewayMethods({
+    registerGatewayMethod(name: string, handler: Handler, options?: { scope?: string }) {
+      expect(options).toEqual({ scope: "operator.admin" });
+      handlers.set(name, handler);
+    },
+  } as never);
+});
+
+afterEach(() => {
+  delete process.env.OPENCLAW_STATE_DIR;
+  fs.rmSync(stateDir, { recursive: true, force: true });
+});
+
+async function call(method: string, params: Record<string, unknown>) {
+  let reply: { ok: boolean; payload?: unknown; error?: unknown } | undefined;
+  const context = {
+    stopChannel: vi.fn(async (_channel: string, accountId?: string) => {
+      if (accountId) running[accountId] = false;
+    }),
+    startChannel: vi.fn(async (_channel: string, accountId?: string) => {
+      if (failStart) throw new Error("start failed");
+      if (accountId) running[accountId] = true;
+    }),
+    getRuntimeSnapshot: () => ({
+      channels: {},
+      channelAccounts: {
+        "openclaw-weixin": Object.fromEntries(
+          Object.entries(running).map(([accountId, isRunning]) => [
+            accountId,
+            { accountId, running: isRunning },
+          ]),
+        ),
+      },
+    }),
+  };
+  await handlers.get(method)!({
+    params,
+    context,
+    respond(ok: boolean, payload?: unknown, error?: unknown) {
+      reply = { ok, payload, error };
+    },
+  });
+  expect(reply, `${method} did not respond`).toBeDefined();
+  if (!reply!.ok) throw new Error(JSON.stringify(reply!.error));
+  return reply!.payload as Record<string, unknown>;
+}
+
+describe("replacement gateway contract", () => {
+  it("keeps confirmed credentials isolated until a generation-bound same-account commit", async () => {
+    const { listIndexedWeixinAccountIds, loadWeixinAccount, saveWeixinAccount, registerWeixinAccountId } =
+      await import("./auth/accounts.js");
+    saveWeixinAccount("account-a", { token: "old-token", userId: "secret-user" });
+    registerWeixinAccountId("account-a");
+    running["account-a"] = true;
+
+    await call("weixin.replacement.begin", {
+      operationId: "replace-1",
+      oldAccountIds: ["account-a"],
+    });
+    expect(listIndexedWeixinAccountIds()).toEqual([]);
+    expect(loadWeixinAccount("account-a")?.token).toBe("old-token");
+
+    const started = await call("weixin.replacement.login.start", { operationId: "replace-1" });
+    expect(started.sessionKey).toEqual(expect.any(String));
+    expect(await call("weixin.replacement.login.start", { operationId: "replace-1" })).toEqual(
+      started,
+    );
+    qr.wait.mockResolvedValue({
+      connected: true,
+      accountId: "account-a",
+      botToken: "new-token",
+      userId: "new-secret-user",
+      baseUrl: "https://api.example.test",
+      message: "connected",
+    });
+    // Simulate the controller losing this RPC response after candidate_ready was persisted.
+    const lostWaitResponse = await call("weixin.replacement.login.wait", {
+      operationId: "replace-1",
+      sessionKey: started.sessionKey,
+    });
+    expect(lostWaitResponse.candidateAccountId).toBe("account-a");
+    expect(lostWaitResponse.loginReceiptId).toEqual(expect.any(String));
+    expect(
+      fs.statSync(path.join(stateDir, "openclaw-weixin", "replacement", "candidate.json")).mode & 0o777,
+    ).toBe(0o600);
+    expect(
+      await call("weixin.replacement.login.wait", {
+        operationId: "replace-1",
+        sessionKey: started.sessionKey,
+      }),
+    ).toEqual(lostWaitResponse);
+    expect(loadWeixinAccount("account-a")?.token).toBe("old-token");
+    expect(listIndexedWeixinAccountIds()).toEqual([]);
+
+    const replacementDir = path.join(stateDir, "openclaw-weixin", "replacement");
+    const operationPath = path.join(replacementDir, "operation.json");
+    const interruptedOperation = JSON.parse(fs.readFileSync(operationPath, "utf-8")) as Record<
+      string,
+      unknown
+    >;
+    interruptedOperation.phase = "login_started";
+    delete interruptedOperation.candidateAccountId;
+    delete interruptedOperation.loginReceiptId;
+    fs.writeFileSync(operationPath, JSON.stringify(interruptedOperation));
+
+    // Startup inspection repairs a crash between candidate.json and operation.json writes,
+    // while the unscoped response still withholds the commit receipt.
+    expect(JSON.stringify(await call("weixin.replacement.inspect", {}))).not.toContain(
+      "loginReceiptId",
+    );
+    expect(JSON.parse(fs.readFileSync(operationPath, "utf-8"))).toMatchObject({
+      phase: "candidate_ready",
+      candidateAccountId: "account-a",
+      loginReceiptId: lostWaitResponse.loginReceiptId,
+    });
+
+    const matchedInspection = await call("weixin.replacement.inspect", {
+      operationId: "replace-1",
+    });
+    const inspectionText = JSON.stringify(matchedInspection);
+    expect(inspectionText).not.toContain("old-token");
+    expect(inspectionText).not.toContain("new-token");
+    expect(inspectionText).not.toContain("secret-user");
+    expect(inspectionText).not.toContain("sessionKey");
+    expect(inspectionText).not.toContain("candidateGeneration");
+    expect(matchedInspection).toMatchObject({
+      operation: {
+        operationId: "replace-1",
+        phase: "candidate_ready",
+        loginReceiptId: lostWaitResponse.loginReceiptId,
+      },
+    });
+    expect(JSON.stringify(await call("weixin.replacement.inspect", {}))).not.toContain(
