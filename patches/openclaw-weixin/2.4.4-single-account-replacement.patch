+import { afterEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("../util/logger.js", () => ({
+  logger: { info: vi.fn(), debug: vi.fn(), warn: vi.fn(), error: vi.fn() },
+}));
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.resetModules();
+});
+
+describe("QR login cancellation", () => {
+  it("aborts QR creation before an active login exists", async () => {
+    const fetchMock = vi.fn((_url: string, init: RequestInit) =>
+      new Promise((_resolve, reject) => {
+        init.signal?.addEventListener("abort", () =>
+          reject(Object.assign(new Error("aborted"), { name: "AbortError" })),
+        );
+      }),
+    );
+    vi.stubGlobal("fetch", fetchMock);
+    const { cancelWeixinLogin, startWeixinLoginWithQr } = await import("./login-qr.js");
+    const starting = startWeixinLoginWithQr({
+      apiBaseUrl: "https://ignored.test",
+      sessionKey: "starting-session",
+    });
+    await vi.waitFor(() => expect(fetchMock).toHaveBeenCalledOnce());
+    expect(cancelWeixinLogin("starting-session")).toMatchObject({ cancelled: true });
+    await expect(starting).resolves.toMatchObject({ sessionKey: "starting-session" });
+  });
+
+  it("aborts an in-flight poll and makes cancellation idempotent", async () => {
+    const fetchMock = vi.fn()
+      .mockResolvedValueOnce({
+        ok: true,
+        status: 200,
+        text: async () => JSON.stringify({ qrcode: "qr-1", qrcode_img_content: "qr-url" }),
+      })
+      .mockImplementationOnce((_url: string, init: RequestInit) =>
+        new Promise((_resolve, reject) => {
+          init.signal?.addEventListener("abort", () =>
+            reject(Object.assign(new Error("aborted"), { name: "AbortError" })),
+          );
+        }),
+      );
+    vi.stubGlobal("fetch", fetchMock);
+    const {
+      cancelWeixinLogin,
+      startWeixinLoginWithQr,
+      waitForWeixinLogin,
+    } = await import("./login-qr.js");
+    const start = await startWeixinLoginWithQr({ apiBaseUrl: "https://ignored.test" });
