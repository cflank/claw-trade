+import {
+  cancelWeixinLogin,
+  listActiveWeixinLoginSessionKeys,
+  startWeixinLoginWithQr,
+  waitForWeixinLogin,
+} from "./auth/login-qr.js";
+import type { WeixinQrWaitResult } from "./auth/login-qr.js";
+import { clearContextTokensForAccount } from "./messaging/inbound.js";
+import { resolveStateDir } from "./storage/state-dir.js";
+
+const CHANNEL_ID = "openclaw-weixin";
+const OPERATION_ID = /^[A-Za-z0-9._-]{1,128}$/;
+
+type Phase =
+  | "beginning"
+  | "suspended"
+  | "login_started"
+  | "candidate_ready"
+  | "committing"
+  | "restoring";
+
+type ReplacementOperation = {
+  operationId: string;
+  oldAccountIds: string[];
+  phase: Phase;
+  candidateGeneration?: string;
+  sessionKey?: string;
+  candidateAccountId?: string;
+  loginReceiptId?: string;
+};
+
+type Candidate = {
+  operationId: string;
+  sessionKey: string;
+  candidateGeneration: string;
+  accountId: string;
+  loginReceiptId: string;
+  token: string;
+  baseUrl?: string;
+  userId?: string;
+};
+
+type TerminalResult = {
+  operationId: string;
+  outcome: "committed" | "restored";
+  loginReceiptId?: string;
+  result: Record<string, unknown>;
+};
+
+function replacementDir(): string {
+  return path.join(resolveStateDir(), "openclaw-weixin", "replacement");
+}
+
+function operationPath(): string {
+  return path.join(replacementDir(), "operation.json");
+}
+
+function candidatePath(): string {
+  return path.join(replacementDir(), "candidate.json");
+}
+
+function terminalPath(): string {
+  return path.join(replacementDir(), "last-result.json");
+}
+
+function writeJson(filePath: string, value: unknown): void {
+  const directory = path.dirname(filePath);
+  fs.mkdirSync(directory, { recursive: true });
+  const temporary = `${filePath}.${process.pid}.${randomUUID()}.tmp`;
+  let file: number | undefined;
+  try {
+    file = fs.openSync(temporary, "wx", 0o600);
+    fs.writeFileSync(file, `${JSON.stringify(value, null, 2)}\n`, "utf-8");
+    fs.fsyncSync(file);
+    fs.closeSync(file);
+    file = undefined;
+    fs.renameSync(temporary, filePath);
+    const directoryHandle = fs.openSync(directory, "r");
+    try {
+      fs.fsyncSync(directoryHandle);
+    } finally {
+      fs.closeSync(directoryHandle);
+    }
+  } finally {
+    if (file !== undefined) fs.closeSync(file);
+    try {
+      fs.unlinkSync(temporary);
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+    }
+  }
+}
+
+function readJson<T>(filePath: string): T | undefined {
+  try {
+    return JSON.parse(fs.readFileSync(filePath, "utf-8")) as T;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined;
+    throw error;
+  }
+}
+
+function removeFile(filePath: string): void {
+  try {
+    fs.unlinkSync(filePath);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+  }
+}
+
+function removeFileForOperation(filePath: string, operationId: string): void {
+  const persisted = readJson<{ operationId?: unknown }>(filePath);
+  if (persisted?.operationId === operationId) removeFile(filePath);
+}
+
+function readOperation(): ReplacementOperation | undefined {
+  return readJson<ReplacementOperation>(operationPath());
+}
+
+function requireOperation(operationId: string): ReplacementOperation {
+  const operation = readOperation();
+  if (!operation || operation.operationId !== operationId) {
+    throw new Error(`replacement operation not found: ${operationId}`);
+  }
+  return operation;
+}
+
+function readString(value: unknown, field: string): string {
+  if (typeof value !== "string" || !value.trim()) throw new Error(`${field} is required`);
+  const result = value.trim();
+  if (field === "operationId" && !OPERATION_ID.test(result)) {
+    throw new Error("operationId contains unsupported characters");
+  }
+  return result;
+}
+
+function readAccountIds(value: unknown): string[] {
+  if (!Array.isArray(value)) throw new Error("oldAccountIds must be an array");
+  return [...new Set(value.map((item) => normalizeAccountId(readString(item, "accountId"))))].sort();
+}
+
+function publicOperation(
+  operation: ReplacementOperation | undefined,
+  includeLoginReceipt = false,
+) {
+  if (!operation) return null;
+  return {
+    operationId: operation.operationId,
+    oldAccountIds: operation.oldAccountIds,
+    phase: operation.phase,
+    candidateAccountId: operation.candidateAccountId,
+    ...(includeLoginReceipt &&
+    operation.phase === "candidate_ready" &&
+    operation.loginReceiptId
+      ? { loginReceiptId: operation.loginReceiptId }
+      : {}),
+  };
+}
+
+function cleanupTerminalResidue(): void {
+  const terminal = readJson<TerminalResult>(terminalPath());
+  if (!terminal) return;
+  const operation = readOperation();
+  const candidate = readJson<Candidate>(candidatePath());
+  if (operation?.operationId === terminal.operationId) {
+    removeFileForOperation(operationPath(), terminal.operationId);
+    removeFileForOperation(candidatePath(), terminal.operationId);
+    return;
+  }
+  if (!operation && candidate?.operationId === terminal.operationId) {
+    removeFileForOperation(candidatePath(), terminal.operationId);
+  }
+}
+
+function recoverPersistedCandidate(): void {
+  const operation = readOperation();
+  if (
+    operation?.phase !== "login_started" ||
+    !operation.sessionKey ||
+    !operation.candidateGeneration
+  ) {
+    return;
+  }
+  const candidate = readJson<Candidate>(candidatePath());
+  if (
+    candidate?.operationId !== operation.operationId ||
+    candidate.sessionKey !== operation.sessionKey ||
+    candidate.candidateGeneration !== operation.candidateGeneration
+  ) {
+    return;
+  }
+  operation.phase = "candidate_ready";
+  operation.candidateAccountId = candidate.accountId;
+  operation.loginReceiptId = candidate.loginReceiptId;
+  writeJson(operationPath(), operation);
+}
+
+function inspection(operationId?: string) {
+  cleanupTerminalResidue();
+  recoverPersistedCandidate();
+  const activeLoginCount = listActiveWeixinLoginSessionKeys().length;
+  const operation = readOperation();
+  const matchesRequestedOperation = Boolean(
+    operation && operationId && operation.operationId === operationId,
+  );
+  return {
+    registeredAccountIds: listIndexedWeixinAccountIds().sort(),
+    storedAccountIds: listStoredWeixinAccountIds(),
+    activeLoginCount,
+    operation:
+      operation && (!operationId || operation.operationId === operationId)
+        ? publicOperation(operation, matchesRequestedOperation)
+        : null,
+    candidatePresent: fs.existsSync(candidatePath()),
+  };
+}
+
+function isRunning(context: any, accountId: string): boolean {
+  const snapshot = context.getRuntimeSnapshot();
+  const direct = snapshot.channelAccounts?.[CHANNEL_ID]?.[accountId];
+  if (direct) return direct.running === true;
+  const fallback = snapshot.channels?.[CHANNEL_ID];
+  return fallback?.accountId === accountId && fallback.running === true;
+}
+
+function respondError(respond: any, error: unknown): void {
+  respond(false, undefined, {
+    code: "invalid_request",
+    message: error instanceof Error ? error.message : String(error),
+  });
+}
+
+type ReplacementLoginResult = {
+  state: "pending" | "connected" | "expired" | "cancelled" | "failed";
+  connected: boolean;
+  message: string;
+  candidateAccountId?: string;
+  loginReceiptId?: string;
+};
+
+type ReplacementLoginTask = {
+  operationId: string;
+  candidateGeneration: string;
+  promise: Promise<ReplacementLoginResult>;
+  result?: ReplacementLoginResult;
+};
+
+const replacementLoginTasks = new Map<string, ReplacementLoginTask>();
+
+function terminalLoginResult(result: WeixinQrWaitResult): ReplacementLoginResult {
+  const state = result.state === "expired"
+    ? "expired"
+    : result.cancelled || result.state === "cancelled"
+      ? "cancelled"
+      : "failed";
+  return { state, connected: false, message: result.message };
+}
+
+function ensureReplacementLoginTask(
+  operationId: string,
+  sessionKey: string,
+  candidateGeneration: string,
+): ReplacementLoginTask {
+  const existing = replacementLoginTasks.get(sessionKey);
+  if (existing) {
+    if (
+      existing.operationId !== operationId ||
+      existing.candidateGeneration !== candidateGeneration
+    ) {
+      throw new Error("sessionKey belongs to another replacement generation");
+    }
+    return existing;
+  }
+
+  const task = {
+    operationId,
+    candidateGeneration,
+  } as ReplacementLoginTask;
+  task.promise = (async (): Promise<ReplacementLoginResult> => {
+    const result = await waitForWeixinLogin({
+      apiBaseUrl: DEFAULT_BASE_URL,
+      sessionKey,
+    });
+    if (!result.connected || !result.accountId || !result.botToken) {
+      return terminalLoginResult(result);
+    }
+    const operation = readOperation();
+    if (
+      operation?.operationId !== operationId ||
+      operation.phase !== "login_started" ||
+      operation.sessionKey !== sessionKey ||
+      operation.candidateGeneration !== candidateGeneration
+    ) {
+      return {
+        state: "cancelled",
+        connected: false,
+        message: "登录结果已被取消。",
+      };
+    }
+    const existingCandidate = readJson<Candidate>(candidatePath());
+    const candidate =
+      existingCandidate?.operationId === operationId &&
+      existingCandidate.sessionKey === sessionKey &&
+      existingCandidate.candidateGeneration === candidateGeneration
+        ? existingCandidate
+        : {
+            operationId,
+            sessionKey,
+            candidateGeneration,
+            accountId: normalizeAccountId(result.accountId),
+            loginReceiptId: randomUUID(),
+            token: result.botToken,
+            baseUrl: result.baseUrl,
+            userId: result.userId,
+          } satisfies Candidate;
+    if (candidate !== existingCandidate) writeJson(candidatePath(), candidate);
+    operation.phase = "candidate_ready";
+    operation.candidateAccountId = candidate.accountId;
+    operation.loginReceiptId = candidate.loginReceiptId;
+    writeJson(operationPath(), operation);
+    return {
+      state: "connected",
+      connected: true,
+      message: result.message,
+      candidateAccountId: candidate.accountId,
+      loginReceiptId: candidate.loginReceiptId,
+    };
+  })().catch((error: unknown) => ({
+    state: "failed",
+    connected: false,
+    message: error instanceof Error ? error.message : String(error),
+  }));
+  task.promise.then((result) => {
+    task.result = result;
+  });
+  replacementLoginTasks.set(sessionKey, task);
+  return task;
+}
+
+async function pollReplacementLoginTask(
+  task: ReplacementLoginTask,
+  timeoutMs: number,
+): Promise<ReplacementLoginResult> {
+  if (task.result) return task.result;
+  return await new Promise((resolve) => {
+    const timer = setTimeout(() => {
+      resolve({
+        state: "pending",
+        connected: false,
+        message: "等待用户扫码。",
+      });
+    }, Math.max(0, timeoutMs));
+    void task.promise.then((result) => {
+      clearTimeout(timer);
+      resolve(result);
+    });
+  });
+}
+
+export function registerWeixinReplacementGatewayMethods(
+  api: Pick<OpenClawPluginApi, "registerGatewayMethod">,
+): void {
+  const registerAdminMethod = api.registerGatewayMethod as unknown as (
+    method: string,
+    handler: Parameters<OpenClawPluginApi["registerGatewayMethod"]>[1],
+    options: { scope: "operator.admin" },
+  ) => void;
+
+  registerAdminMethod(
+    "weixin.replacement.begin",
+    async ({ params, context, respond }) => {
+      try {
+        const input = params as Record<string, unknown>;
+        const operationId = readString(input.operationId, "operationId");
+        const oldAccountIds = readAccountIds(input.oldAccountIds);
+        cleanupTerminalResidue();
+        const terminal = readJson<TerminalResult>(terminalPath());
+        if (terminal?.operationId === operationId) {
+          respond(true, terminal.result);
+          return;
+        }
+        let operation = readOperation();
+        if (operation) {
+          if (
+            operation.operationId !== operationId ||
+            JSON.stringify(operation.oldAccountIds) !== JSON.stringify(oldAccountIds)
+          ) {
+            throw new Error(`another replacement operation is active: ${operation.operationId}`);
+          }
+          if (operation.phase !== "beginning") {
+            respond(true, inspection(operationId));
+            return;
+          }
+        } else {
+          const registered = listIndexedWeixinAccountIds();
+          if (JSON.stringify([...registered].sort()) !== JSON.stringify(oldAccountIds)) {
+            throw new Error("oldAccountIds must contain every registered account exactly once");
+          }
+          const unexpectedStored = listStoredWeixinAccountIds()
+            .map((id) => normalizeAccountId(id))
+            .filter((id) => !oldAccountIds.includes(id));
+          if (unexpectedStored.length) {
+            throw new Error(`unregistered account credentials exist: ${unexpectedStored.join(",")}`);
+          }
+          operation = { operationId, oldAccountIds, phase: "beginning" };
+          writeJson(operationPath(), operation);
+        }
+        for (const accountId of oldAccountIds) {
+          await context.stopChannel(CHANNEL_ID, accountId);
+        }
+        const stillRunning = oldAccountIds.filter((accountId) => isRunning(context, accountId));
+        if (stillRunning.length) throw new Error(`old accounts are still running: ${stillRunning.join(",")}`);
+        replaceIndexedWeixinAccountIds(
+          listIndexedWeixinAccountIds().filter((id) => !oldAccountIds.includes(id)),
+        );
+        operation.phase = "suspended";
+        writeJson(operationPath(), operation);
+        respond(true, inspection(operationId));
+      } catch (error) {
+        respondError(respond, error);
+      }
+    },
+    { scope: "operator.admin" },
+  );
+
+  registerAdminMethod(
+    "weixin.replacement.login.start",
+    async ({ params, respond }) => {
+      try {
+        const operationId = readString((params as Record<string, unknown>).operationId, "operationId");
+        const operation = requireOperation(operationId);
+        if (operation.phase === "candidate_ready") {
+          respond(true, {
+            operationId,
+            sessionKey: operation.sessionKey,
+            candidateAccountId: operation.candidateAccountId,
+            loginReceiptId: operation.loginReceiptId,
+          });
+          return;
+        }
+        if (operation.phase !== "suspended" && operation.phase !== "login_started") {
+          throw new Error(`replacement login cannot start in phase ${operation.phase}`);
+        }
+        operation.sessionKey ??= randomUUID();
+        operation.candidateGeneration ??= randomUUID();
+        operation.phase = "login_started";
+        writeJson(operationPath(), operation);
+        const result = await startWeixinLoginWithQr({
+          apiBaseUrl: DEFAULT_BASE_URL,
+          sessionKey: operation.sessionKey,
+        });
+        if (!result.qrcodeUrl) {
+          operation.phase = "suspended";
+          operation.sessionKey = undefined;
+          operation.candidateGeneration = undefined;
+          writeJson(operationPath(), operation);
+          throw new Error(result.message);
+        }
+        respond(true, {
+          operationId,
+          sessionKey: result.sessionKey,
+          qrDataUrl: result.qrcodeUrl,
+          message: result.message,
+        });
+      } catch (error) {
+        respondError(respond, error);
+      }
+    },
+    { scope: "operator.admin" },
+  );
+
+  registerAdminMethod(
+    "weixin.replacement.login.wait",
+    async ({ params, respond }) => {
+      try {
+        const input = params as Record<string, unknown>;
+        const operationId = readString(input.operationId, "operationId");
+        const sessionKey = readString(input.sessionKey, "sessionKey");
+        const knownTask = replacementLoginTasks.get(sessionKey);
+        if (knownTask) {
+          if (knownTask.operationId !== operationId) {
+            throw new Error("sessionKey does not belong to operation");
+          }
+          const timeoutMs =
+            typeof input.timeoutMs === "number" && Number.isFinite(input.timeoutMs)
+              ? Math.max(0, input.timeoutMs)
+              : 0;
+          respond(true, await pollReplacementLoginTask(knownTask, timeoutMs));
+          return;
+        }
+        let operation = requireOperation(operationId);
+        if (operation.sessionKey !== sessionKey) throw new Error("sessionKey does not belong to operation");
+        if (operation.phase === "candidate_ready") {
+          respond(true, {
+            state: "connected",
+            connected: true,
+            message: "微信登录已确认。",
+            candidateAccountId: operation.candidateAccountId,
+            loginReceiptId: operation.loginReceiptId,
+          });
+          return;
+        }
+        if (operation.phase !== "login_started" || !operation.candidateGeneration) {
+          throw new Error(`replacement login cannot wait in phase ${operation.phase}`);
+        }
+        const generation = operation.candidateGeneration;
+        const task = ensureReplacementLoginTask(operationId, sessionKey, generation);
+        const timeoutMs =
+          typeof input.timeoutMs === "number" && Number.isFinite(input.timeoutMs)
+            ? Math.max(0, input.timeoutMs)
+            : 0;
+        respond(true, await pollReplacementLoginTask(task, timeoutMs));
+      } catch (error) {
+        respondError(respond, error);
+      }
+    },
+    { scope: "operator.admin" },
+  );
+
+  registerAdminMethod(
+    "weixin.login.cancel",
+    ({ params, respond }) => {
+      try {
+        const sessionKey = readString((params as Record<string, unknown>).sessionKey, "sessionKey");
+        const operation = readOperation();
+        if (operation?.sessionKey === sessionKey && operation.phase === "login_started") {
+          if (operation.candidateGeneration && !replacementLoginTasks.has(sessionKey)) {
+            const result: ReplacementLoginResult = {
+              state: "cancelled",
+              connected: false,
+              message: "登录已取消。",
+            };
+            replacementLoginTasks.set(sessionKey, {
+              operationId: operation.operationId,
+              candidateGeneration: operation.candidateGeneration,
+              result,
+              promise: Promise.resolve(result),
+            });
+          }
+          operation.phase = "suspended";
+          operation.sessionKey = undefined;
+          operation.candidateGeneration = undefined;
+          writeJson(operationPath(), operation);
+        }
+        respond(true, { sessionKey, ...cancelWeixinLogin(sessionKey) });
+      } catch (error) {
+        respondError(respond, error);
+      }
+    },
+    { scope: "operator.admin" },
+  );
+
+  registerAdminMethod(
+    "weixin.replacement.commit",
+    async ({ params, context, respond }) => {
+      try {
+        const input = params as Record<string, unknown>;
+        const operationId = readString(input.operationId, "operationId");
+        const loginReceiptId = readString(input.loginReceiptId, "loginReceiptId");
+        const terminal = readJson<TerminalResult>(terminalPath());
+        if (
+          terminal?.operationId === operationId &&
+          terminal.outcome === "committed" &&
+          terminal.loginReceiptId === loginReceiptId
+        ) {
+          removeFileForOperation(candidatePath(), operationId);
+          removeFileForOperation(operationPath(), operationId);
+          respond(true, terminal.result);
+          return;
+        }
+        const operation = requireOperation(operationId);
+        const candidate = readJson<Candidate>(candidatePath());
+        if (
+          (operation.phase !== "candidate_ready" && operation.phase !== "committing") ||
+          !candidate ||
+          candidate.operationId !== operationId ||
+          candidate.loginReceiptId !== loginReceiptId ||
+          candidate.sessionKey !== operation.sessionKey ||
+          candidate.candidateGeneration !== operation.candidateGeneration
+        ) {
+          throw new Error("login receipt does not match replacement generation");
+        }
+        if (operation.phase === "candidate_ready" && listIndexedWeixinAccountIds().length !== 0) {
+          throw new Error("unexpected registered account appeared during replacement");
+        }
+        operation.phase = "committing";
+        writeJson(operationPath(), operation);
+        writeWeixinAccount(candidate.accountId, {
+          token: candidate.token,
+          baseUrl: candidate.baseUrl,
+          userId: candidate.userId,
+          savedAt: new Date().toISOString(),
+        });
+        replaceIndexedWeixinAccountIds([candidate.accountId]);
+        await context.startChannel(CHANNEL_ID, candidate.accountId);
+        if (!isRunning(context, candidate.accountId)) {
+          throw new Error(`candidate account did not start: ${candidate.accountId}`);
+        }
+        for (const oldAccountId of operation.oldAccountIds) {
+          clearContextTokensForAccount(oldAccountId);
+          clearWeixinAccountFiles(oldAccountId, oldAccountId === candidate.accountId);
+        }
+        const registeredAccountIds = listIndexedWeixinAccountIds().sort();
+        const storedAccountIds = listStoredWeixinAccountIds().map(normalizeAccountId).sort();
+        if (
+          JSON.stringify(registeredAccountIds) !== JSON.stringify([candidate.accountId]) ||
+          JSON.stringify(storedAccountIds) !== JSON.stringify([candidate.accountId])
+        ) {
+          throw new Error("replacement commit could not prove a unique canonical account");
+        }
+        const result = {
+          operationId,
+          committed: true,
+          accountId: candidate.accountId,
+          registeredAccountIds,
+          storedAccountIds,
+          running: true,
+          activeLoginCount: listActiveWeixinLoginSessionKeys().length,
+        };
+        const completed: TerminalResult = {
+          operationId,
+          outcome: "committed",
+          loginReceiptId,
+          result,
+        };
+        writeJson(terminalPath(), completed);
+        removeFile(candidatePath());
+        removeFile(operationPath());
+        respond(true, result);
+      } catch (error) {
+        respondError(respond, error);
+      }
+    },
+    { scope: "operator.admin" },
+  );
+
+  registerAdminMethod(
+    "weixin.replacement.restore",
+    async ({ params, context, respond }) => {
+      try {
+        const operationId = readString((params as Record<string, unknown>).operationId, "operationId");
+        const terminal = readJson<TerminalResult>(terminalPath());
+        if (terminal?.operationId === operationId && terminal.outcome === "restored") {
+          removeFileForOperation(candidatePath(), operationId);
+          removeFileForOperation(operationPath(), operationId);
+          respond(true, terminal.result);
+          return;
+        }
+        const operation = requireOperation(operationId);
+        if (operation.phase === "committing") {
+          throw new Error("replacement commit has started and must be resumed");
+        }
+        if (operation.sessionKey) cancelWeixinLogin(operation.sessionKey);
+        operation.phase = "restoring";
+        writeJson(operationPath(), operation);
+        removeFile(candidatePath());
+        replaceIndexedWeixinAccountIds(operation.oldAccountIds);
+        for (const accountId of operation.oldAccountIds) {
+          await context.startChannel(CHANNEL_ID, accountId);
+        }
+        const notRunning = operation.oldAccountIds.filter((accountId) => !isRunning(context, accountId));
+        if (notRunning.length) {
+          throw new Error(`restored accounts did not start: ${notRunning.join(",")}`);
+        }
+        const result = {
+          operationId,
+          restored: true,
+          registeredAccountIds: listIndexedWeixinAccountIds(),
+          storedAccountIds: listStoredWeixinAccountIds(),
+          runningAccountIds: operation.oldAccountIds,
+        };
+        writeJson(terminalPath(), { operationId, outcome: "restored", result } satisfies TerminalResult);
+        removeFile(operationPath());
+        respond(true, result);
+      } catch (error) {
+        respondError(respond, error);
+      }
+    },
+    { scope: "operator.admin" },
+  );
+
+  registerAdminMethod(
+    "weixin.replacement.inspect",
+    ({ params, respond }) => {
+      try {
+        const raw = (params as Record<string, unknown>).operationId;
+        const operationId = raw === undefined ? undefined : readString(raw, "operationId");
+        respond(true, inspection(operationId));
+      } catch (error) {
+        respondError(respond, error);
+      }
+    },
+    { scope: "operator.admin" },
+  );
+}

