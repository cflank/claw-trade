# Copy this file to .runtime/virbox-protected-package.env and edit local paths.
# Do not put real .ssp files into git or into the delivery package.

# Optional. Leave empty to use the newest dist/production/claw-trade-production-*.tar.gz.
INPUT_ARCHIVE=

# Output directory for the protected delivery tar.gz and .sha256.
OUTPUT_DIR=/mnt/d/claw-trade-virbox/delivery-output/virbox-protected-${STAMP}

# Windows Virbox tool paths as seen from WSL.
DSPROTECTOR=/mnt/d/sw/senseshield/sdk/Tool/VirboxProtect/bin/dsprotector_con.exe

# Files generated once by Virbox Protector UI.
PROTECTED_PYTHON=/mnt/d/claw-trade-virbox/resource-test/protect-python-ds/protected/python
PYTHON_SSP=/mnt/d/claw-trade-virbox/resource-test/protect-python-ds/python.ssp
PROTECTED_NODE=/mnt/d/claw-trade-virbox/node-ds-test/input/protected/node
NODE_SSP=/mnt/d/claw-trade-virbox/node-ds-test/input/node.ssp

# Optional. Leave empty unless you need a fixed intermediate directory.
WORK_DIR=
